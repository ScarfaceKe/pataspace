# ==========================
# SUPABASE
# ==========================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Phase 1 server-side PostgreSQL connection used by the existing production database layer.
# Keep server-only. Do not expose this value to the browser.
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_SSL=true
SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=true
SUPABASE_DB_POOL_MAX=10

# ==========================
# AUTHENTICATION
# ==========================
JWT_SECRET=
SESSION_SECRET=
PATASPACE_BCRYPT_COST=12
PATASPACE_REQUIRE_EMAIL_VERIFICATION=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# ==========================
# EMAIL
# ==========================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==========================
# MEGAPAY
# ==========================
MEGAPAY_CONSUMER_KEY=
MEGAPAY_CONSUMER_SECRET=
MEGAPAY_SHORTCODE=
MEGAPAY_PASSKEY=
MEGAPAY_CALLBACK_URL=


# ==========================
# WHATSAPP BUSINESS API
